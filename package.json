{
  "name": "skadevi-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "Skadevi Gård — statisk webbplats (Vite MPA) + Node-server med kalender-API",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.mjs",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "admin": "node server/admin/index.js",
    "admin:dev": "node server/admin/index.js --demo --dev-auth",
    "package:admin": "node scripts/package-admin.mjs",
    "smoke:admin": "node scripts/smoke-admin-package.mjs",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/unit/*.test.mjs\"",
    "test:resend-mock": "node --test tests/unit/mock-resend.test.js tests/unit/resend-flow-integration.test.js tests/unit/resend-test-env.test.js",
    "verify:resend-test": "node scripts/verify-test-workflow.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "stripe:test-mode": "node scripts/stripe-test-mode-check.mjs",
    "seed:test-outbox": "node scripts/test-outbox-seed.mjs",
    "mock:resend": "node scripts/mock-resend.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "lint": "eslint .",
    "sync:header": "node scripts/sync-header.mjs",
    "sync:footer": "node scripts/sync-footer.mjs",
    "sync:analytics": "node scripts/sync-analytics.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "thumbs": "node scripts/generate-gallery-thumbs.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "node-ical": "0.27.3",
    "pdfkit": "^0.20.2",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "eslint": "^9.39.5",
    "lighthouse": "13.6.0",
    "pdf-parse": "^2.4.5",
    "sharp": "0.35.5",
    "vite": "8.3.7"
  }
}
