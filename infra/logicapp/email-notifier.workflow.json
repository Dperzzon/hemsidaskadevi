{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageEndpoint": {
      "defaultValue": "https://SKADEVI-LAGRINGSKONTO.table.core.windows.net",
      "type": "String"
    },
    "tableName": {
      "defaultValue": "bookingrequests",
      "type": "String"
    },
    "maxAttempts": {
      "defaultValue": 5,
      "type": "Int"
    },
    "resendApiUrl": {
      "defaultValue": "https://api.resend.com/emails",
      "type": "String"
    },
    "mailFrom": {
      "defaultValue": "bokning@skadeviherrgard.com",
      "type": "String"
    },
    "mailReplyTo": {
      "defaultValue": "skadevigard@gmail.com",
      "type": "String"
    },
    "hostRecipient": {
      "defaultValue": "skadevigard@gmail.com",
      "type": "String"
    },
    "keyVaultSecretUri": {
      "defaultValue": "https://SKADEVI-KEYVAULT.vault.azure.net/secrets/resend-api-key?api-version=7.4",
      "type": "String"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Minute",
        "interval": 5,
        "timeZone": "W. Europe Standard Time"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Haemta_utkorg": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@{parameters('storageEndpoint')}/@{parameters('tableName')}()?$filter=PartitionKey%20eq%20%27outbox%27%20and%20(status%20ne%20%27Skickad%27%20and%20attemptCount%20lt%20@{parameters('maxAttempts')})",
        "headers": {
          "x-ms-version": "2019-02-02"
        },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://storage.azure.com/"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": ["inputs", "outputs"]
        }
      }
    },
    "Om_det_finns_poster": {
      "type": "If",
      "runAfter": {
        "Haemta_utkorg": ["Succeeded"]
      },
      "expression": "@greater(length(body('Haemta_utkorg')?['value']), 0)",
      "actions": {
        "Behandla_varje_post": {
          "type": "Foreach",
          "foreach": "@body('Haemta_utkorg')?['value']",
          "actions": {
            "Hamta_api_nyckel": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('keyVaultSecretUri')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://vault.azure.net"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": ["inputs", "outputs"]
                }
              }
            },
            "Markera_som_under_skickning": {
              "type": "Http",
              "runAfter": {
                "Hamta_api_nyckel": ["Succeeded"]
              },
              "inputs": {
                "method": "PATCH",
                "uri": "@{parameters('storageEndpoint')}/@{parameters('tableName')}(PartitionKey='@{items('Behandla_varje_post')?['PartitionKey']}',RowKey='@{items('Behandla_varje_post')?['RowKey']}')",
                "headers": {
                  "x-ms-version": "2019-02-02",
                  "If-Match": "@{items('Behandla_varje_post')?['odata.etag']}"
                },
                "body": {
                  "status": "Skickar",
                  "attemptedAt": "@{utcNow()}",
                  "attemptCount@odata.type": "Edm.Int32",
                  "attemptCount": "@add(items('Behandla_varje_post')?['attemptCount'], 1)"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://storage.azure.com/"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": ["inputs", "outputs"]
                }
              }
            },
            "Skicka_mejl_resend": {
              "type": "Http",
              "runAfter": {
                "Markera_som_under_skickning": ["Succeeded"]
              },
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('resendApiUrl')}",
                "headers": {
                  "Content-Type": "application/json",
                  "Authorization": "Bearer @{body('Hamta_api_nyckel')?['value']}",
                  "Idempotency-Key": "@{items('Behandla_varje_post')?['RowKey']}"
                },
                "body": {
                  "from": "@{parameters('mailFrom')}",
                  "to": "@{items('Behandla_varje_post')?['mailTo']}",
                  "reply_to": "@{parameters('mailReplyTo')}",
                  "subject": "@{items('Behandla_varje_post')?['mailSubject']}",
                  "html": "@{items('Behandla_varje_post')?['mailHtml']}"
                }
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 4,
                "minimumInterval": "PT30S",
                "maximumInterval": "PT10M"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": ["inputs", "outputs"]
                }
              }
            },
            "Markera_som_skickad": {
              "type": "Http",
              "runAfter": {
                "Skicka_mejl_resend": ["Succeeded"]
              },
              "inputs": {
                "method": "PATCH",
                "uri": "@{parameters('storageEndpoint')}/@{parameters('tableName')}(PartitionKey='@{items('Behandla_varje_post')?['PartitionKey']}',RowKey='@{items('Behandla_varje_post')?['RowKey']}')",
                "headers": {
                  "x-ms-version": "2019-02-02",
                  "If-Match": "*"
                },
                "body": {
                  "status": "Skickad",
                  "sentAt": "@{utcNow()}",
                  "resendId": "@{body('Skicka_mejl_resend')?['id']}",
                  "deliveryStatus": "Inväntar leveranskontroll"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://storage.azure.com/"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": ["inputs", "outputs"]
                }
              }
            },
            "Markera_som_misslyckad": {
              "type": "Http",
              "runAfter": {
                "Skicka_mejl_resend": ["Failed", "TimedOut"]
              },
              "inputs": {
                "method": "PATCH",
                "uri": "@{parameters('storageEndpoint')}/@{parameters('tableName')}(PartitionKey='@{items('Behandla_varje_post')?['PartitionKey']}',RowKey='@{items('Behandla_varje_post')?['RowKey']}')",
                "headers": {
                  "x-ms-version": "2019-02-02",
                  "If-Match": "*"
                },
                "body": {
                  "status": "Misslyckad",
                  "failedAt": "@{utcNow()}",
                  "deliveryStatus": "Skick misslyckades"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://storage.azure.com/"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": ["inputs", "outputs"]
                }
              }
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
