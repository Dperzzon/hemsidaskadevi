    "workflowDefinition": "{\n  \"$schema\": \"https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#\",\n  \"contentVersion\": \"1.0.0.0\",\n  \"parameters\": {\n    \"$connections\": {\n      \"defaultValue\": {},\n      \"type\": \"Object\"\n    },\n    \"storageEndpoint\": {\n      \"defaultValue\": \"https://SKADEVI-LAGRINGSKONTO.table.core.windows.net\",\n      \"type\": \"String\"\n    },\n    \"tableName\": {\n      \"defaultValue\": \"bookingrequests\",\n      \"type\": \"String\"\n    },\n    \"maxAttempts\": {\n      \"defaultValue\": 5,\n      \"type\": \"Int\"\n    }\n  },\n  \"triggers\": {\n    \"Recurrence\": {\n      \"recurrence\": {\n        \"frequency\": \"Minute\",\n        \"interval\": 5,\n        \"timeZone\": \"W. Europe Standard Time\"\n      },\n      \"runtimeConfiguration\": {\n        \"concurrency\": {\n          \"runs\": 1\n        }\n      },\n      \"type\": \"Recurrence\"\n    }\n  },\n  \"actions\": {\n    \"Haemta_utkorg\": {\n      \"type\": \"Http\",\n      \"inputs\": {\n        \"method\": \"GET\",\n        \"uri\": \"@{parameters('storageEndpoint')}/@{parameters('tableName')}()?$filter=PartitionKey%20eq%20%27outbox%27%20and%20(status%20ne%20%27Skickad%27%20and%20attemptCount%20lt%20@{parameters('maxAttempts')})\",\n        \"headers\": {\n          \"x-ms-version\": \"2019-02-02\"\n        },\n        \"authentication\": {\n          \"type\": \"ManagedServiceIdentity\",\n          \"audience\": \"https://storage.azure.com/\"\n        }\n      },\n      \"runtimeConfiguration\": {\n        \"secureData\": {\n          \"properties\": [\"inputs\", \"outputs\"]\n        }\n      }\n    },\n    \"Om_det_finns_poster\": {\n      \"type\": \"If\",\n      \"expression\": \"@greater(length(body('Haemta_utkorg')?['value']), 0)\",\n      \"actions\": {\n        \"Behandla_varje_post\": {\n          \"type\": \"Foreach\",\n          \"foreach\": \"@body('Haemta_utkorg')?['value']\",\n          \"actions\": {\n            \"Markera_som_under_skickning\": {\n              \"type\": \"Http\",\n              \"inputs\": {\n                \"method\": \"PATCH\",\n                \"uri\": \"@{parameters('storageEndpoint')}/@{parameters('tableName')}(PartitionKey='@{items('Behandla_varje_post')?['PartitionKey']}',RowKey='@{items('Behandla_varje_post')?['RowKey']}')\",\n                \"headers\": {\n                  \"x-ms-version\": \"2019-02-02\",\n                  \"If-Match\": \"@{items('Behandla_varje_post')?['odata.etag']}\"\n                },\n                \"body\": {\n                  \"status\": \"Skickar\",\n                  \"attemptedAt\": \"@{utcNow()}\",\n                  \"attemptCount@odata.type\": \"Edm.Int32\",\n                  \"attemptCount\": \"@add(items('Behandla_varje_post')?['attemptCount'], 1)\"\n                },\n                \"authentication\": {\n                  \"type\": \"ManagedServiceIdentity\",\n                  \"audience\": \"https://storage.azure.com/\"\n                }\n              },\n              \"runtimeConfiguration\": {\n                \"secureData\": {\n                  \"properties\": [\"inputs\", \"outputs\"]\n                }\n              }\n            },\n            \"Skicka_mejl_(V2)\": {\n              \"type\": \"ApiConnection\",\n              \"inputs\": {\n                \"host\": {\n                  \"connection\": {\n                    \"name\": \"@parameters('$connections')['gmail']['connectionId']\"\n                  }\n                },\n                \"method\": \"post\",\n                \"path\": \"/v2/Mail\",\n                \"body\": {\n                  \"To\": \"@{items('Behandla_varje_post')?['mailTo']}\",\n                  \"Subject\": \"@{items('Behandla_varje_post')?['mailSubject']}\",\n                  \"Body\": \"@{items('Behandla_varje_post')?['mailHtml']}\",\n                  \"IsHtml\": true\n                }\n              },\n              \"retryPolicy\": {\n                \"type\": \"exponential\",\n                \"count\": 4,\n                \"minimumInterval\": \"PT30S\",\n                \"maximumInterval\": \"PT10M\"\n              }\n            },\n            \"Markera_som_skickad\": {\n              \"type\": \"Http\",\n              \"inputs\": {\n                \"method\": \"PATCH\",\n                \"uri\": \"@{parameters('storageEndpoint')}/@{parameters('tableName')}(PartitionKey='@{items('Behandla_varje_post')?['PartitionKey']}',RowKey='@{items('Behandla_varje_post')?['RowKey']}')\",\n                \"headers\": {\n                  \"x-ms-version\": \"2019-02-02\",\n                  \"If-Match\": \"*\"\n                },\n                \"body\": {\n                  \"status\": \"Skickad\",\n                  \"sentAt\": \"@{utcNow()}\"\n                },\n                \"authentication\": {\n                  \"type\": \"ManagedServiceIdentity\",\n                  \"audience\": \"https://storage.azure.com/\"\n                }\n              },\n              \"runAfter\": {\n                \"Skicka_mejl_(V2)\": [\"Succeeded\"]\n              },\n              \"runtimeConfiguration\": {\n                \"secureData\": {\n                  \"properties\": [\"inputs\", \"outputs\"]\n                }\n              }\n            },\n            \"Markera_som_misslyckad\": {\n              \"type\": \"Http\",\n              \"inputs\": {\n                \"method\": \"PATCH\",\n                \"uri\": \"@{parameters('storageEndpoint')}/@{parameters('tableName')}(PartitionKey='@{items('Behandla_varje_post')?['PartitionKey']}',RowKey='@{items('Behandla_varje_post')?['RowKey']}')\",\n                \"headers\": {\n                  \"x-ms-version\": \"2019-02-02\",\n                  \"If-Match\": \"*\"\n                },\n                \"body\": {\n                  \"status\": \"Misslyckad\"\n                },\n                \"authentication\": {\n                  \"type\": \"ManagedServiceIdentity\",\n                  \"audience\": \"https://storage.azure.com/\"\n                }\n              },\n              \"runAfter\": {\n                \"Skicka_mejl_(V2)\": [\"Failed\", \"TimedOut\"]\n              },\n              \"runtimeConfiguration\": {\n                \"secureData\": {\n                  \"properties\": [\"inputs\", \"outputs\"]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"outputs\": {}\n}\n"
  },
