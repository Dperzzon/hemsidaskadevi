{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/foretag", "rewrite": "/pages/foretag.html" },
    { "route": "/fest", "rewrite": "/pages/fest.html" },
    { "route": "/brollop", "rewrite": "/pages/brollop.html" },
    { "route": "/semester", "rewrite": "/pages/semester.html" },
    { "route": "/boende", "rewrite": "/pages/boende.html" },
    { "route": "/aktiviteter", "rewrite": "/pages/aktiviteter.html" },
    { "route": "/priser", "rewrite": "/pages/priser.html" },
    { "route": "/mat-dryck", "rewrite": "/pages/mat-dryck.html" },
    { "route": "/om-oss", "rewrite": "/pages/om-oss.html" },
    { "route": "/vanliga-fragor", "rewrite": "/pages/vanliga-fragor.html" },
    { "route": "/kontakt", "rewrite": "/pages/kontakt.html" },
    { "route": "/digital-visning", "rewrite": "/pages/digital-visning.html" },
    { "route": "/boka", "rewrite": "/pages/boka.html" },
    { "route": "/lediga-datum", "rewrite": "/pages/lediga-datum.html" }
